# Copia este archivo a .env.local y rellena las llaves.
# Sin ninguna de estas variables el sitio funciona igual en "modo demo":
# el checkout confirma el pedido localmente en lugar de cobrar.

# ── Stripe ──────────────────────────────────────────────────────────────────
# Modo prueba: llaves pk_test_ / sk_test_. Tarjeta de prueba 4242 4242 4242 4242.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Sitio ───────────────────────────────────────────────────────────────────
# URL pública, usada en metadata/OG y para volver de Stripe Checkout.
# En Vercel se detecta sola; defínela solo si usas dominio propio.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Cotizaciones de medida especial ─────────────────────────────────────────
# Correo del taller que recibe las solicitudes. Sin RESEND_API_KEY la solicitud
# se registra en los logs del servidor en lugar de enviarse.
RESEND_API_KEY=
COTIZACIONES_EMAIL=taller@broka.mx
